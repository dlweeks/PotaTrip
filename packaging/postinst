#!/bin/sh
# postinst — create service user/state dir, build the venv ON THIS MACHINE,
# install app dependencies, then enable + start the unit.
set -e

# Dedicated system user/group (no login shell).
if ! getent group potatrip >/dev/null; then
    groupadd --system potatrip
fi
if ! getent passwd potatrip >/dev/null; then
    useradd --system --gid potatrip --home-dir /var/lib/potatrip \
        --shell /usr/sbin/nologin --comment "POTA Trip Planner" potatrip
fi

# Writable state (park CSV cache, log file).
install -d -o potatrip -g potatrip /var/lib/potatrip

# Build the virtual environment with the target's own python3, then install
# the app's dependencies into it. Runs at install time so no pre-built,
# wrong-architecture wheels are ever shipped.
VENV=/opt/PotaTrip/.venv
if [ ! -x "$VENV/bin/python" ]; then
    echo "Building python venv at $VENV (this downloads flask, pandas, geopy, requests)..."
    python3 -m venv "$VENV"
fi
"$VENV/bin/pip" install --no-cache-dir -r /opt/PotaTrip/requirements.txt
chown -R root:potatrip "$VENV"
chmod -R g-w "$VENV"

# Launcher must be executable.
chmod 755 /usr/local/bin/potatrip

# Enable and start the systemd service.
if command -v deb-systemd-helper >/dev/null 2>&1; then
    deb-systemd-helper unmask potatrip.service >/dev/null || true
    deb-systemd-helper update potatrip.service >/dev/null || true
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl --system daemon-reload >/dev/null || true
    systemctl enable potatrip.service >/dev/null || true
    systemctl restart potatrip.service || true
fi

exit 0
